#!/bin/bash

export PATH="${PATH}:${HOME}/.local/bin/"

# Create a lock to prevent multiple instances
LOCKFILE="/tmp/wallpaper-change.lock"
if [ -e "$LOCKFILE" ]; then
    echo "Another wallpaper change is in progress. Exiting."
    exit 0
fi
touch "$LOCKFILE"
trap "rm -f $LOCKFILE" EXIT

dir="$HOME/.config/rofi/launchers/type-1"
theme='style-1'

wallpapers=$HOME/Wallpapers
image="$(ls $wallpapers | rofi -dmenu -i -p "  Select wallpaper: " -theme ${dir}/${theme}.rasi)"

# Exit if user pressed escape or no selection was made
if [[ -z "$image" ]]; then
    echo "No wallpaper selected. Exiting."
    exit 0
fi

wallpaper=$wallpapers/$image

if [[ -d "$wallpaper" ]]; then
    # choose a file inside the selected directory
    sleep 2
    inner="$(ls "$wallpaper" | wofi -n --show dmenu -k "/dev/null")"
    
    # Exit if user pressed escape on the nested selection
    if [[ -z "$inner" ]]; then
        echo "No wallpaper selected from directory. Exiting."
        exit 0
    fi
    
    wallpaper="$wallpaper/$inner"
elif [[ -f "$wallpaper" ]]; then
    wallpaper="$wallpaper"
else
    echo "$wallpaper is not valid"
    exit 1
fi

# Check if swww daemon is running, if not start it
if ! pgrep -x "swww-daemon" > /dev/null; then
    swww-daemon &
    sleep 2  # Give daemon time to start
fi

swww img $wallpaper --transition-type grow --transition-fps 60 --transition-duration 0.5 --transition-bezier 0.65,0,0.35,1 --transition-step 1

sleep 1.25

# Log before reading mode
echo "[$(date '+%H:%M:%S')] Rofi wallpaper: Before reading mode: $(cat ~/.cache/wal/mode 2>/dev/null || echo 'no file')" >> ~/.cache/wal/wallpaper-changes.log

# Check if mode file exists, default to dark if not
if [[ -e "${HOME}/.cache/wal/mode" ]]; then
    MODE="$(cat ~/.cache/wal/mode | tr -d '[:space:]')"
else
    mkdir -p "${HOME}/.cache/wal"
    echo "dark" > "${HOME}/.cache/wal/mode"
    MODE="dark"
fi

# Validate mode value
if [[ "$MODE" != "light" && "$MODE" != "dark" ]]; then
    echo "dark" > "${HOME}/.cache/wal/mode"
    MODE="dark"
fi

if [[ "$MODE" = "light" ]]; then
  wal -i $wallpaper -l
  # Ensure mode persists after wal runs
  echo "light" > "${HOME}/.cache/wal/mode"
  echo "[$(date '+%H:%M:%S')] Rofi wallpaper: Applied LIGHT mode to $wallpaper" >> ~/.cache/wal/wallpaper-changes.log
else
  wal -i $wallpaper
  # Ensure mode persists after wal runs
  echo "dark" > "${HOME}/.cache/wal/mode"
  echo "[$(date '+%H:%M:%S')] Rofi wallpaper: Applied DARK mode to $wallpaper" >> ~/.cache/wal/wallpaper-changes.log
fi

pywalfox update
pywal-discord -t default
wal-telegram --wal

. $HOME/.config/mako/update-colors.sh
. $HOME/.config/spicetify/Themes/Pywal/update-colors.sh